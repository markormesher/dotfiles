{
  "position": "top",
  "spacing": 4,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/window"
  ],
  "modules-right": [
    "custom/needs-reboot",
    "wireplumber",
    "backlight",
    "battery",
    "sway/language",
    "clock",
    "tray"
  ],

  "sway/workspaces": {},
  "sway/mode": {
    "format": "󱐋 {}"
  },
  "swap/window": {
    "max-length": 50
  },

  "custom/needs-reboot": {
    "exec": "~/.config/waybar/needs-reboot.sh",
    "interval": 600,
    "return-type": "json",
    "hide-empty-text": true
  },

  "wireplumber": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰸈 {volume}%",
    "on-click": "helvum"
  },
  "backlight": {
    "format": "󰌵 {percent}%",
    "on-click": "~/.config/waybar/toggle-theme.sh"
  },
  "battery": {
    "format-charging": "󰚥 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-discharging": "{icon} {capacity}% ({time})",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-time": "{H}:{m}"
  },
  "sway/language": {
    "format": "{short}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "clock": {
    "format": "{:%d %b / %T}",
    "interval": 1
  },
  "tray": {
    "expand": true,
    "spacing": 4
  }
}
